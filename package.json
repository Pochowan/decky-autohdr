{
  "name": "autohdr-gamescope",
  "version": "1.0.0",
  "description": "AutoHDR for Decky Loader: SDR to HDR10 for any Vulkan/Proton game via a native Vulkan layer",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.7.2",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "author": "Pochowan",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pochowan/decky-autohdr.git"
  },
  "homepage": "https://github.com/Pochowan/decky-autohdr",
  "keywords": [
    "decky",
    "plugin",
    "hdr",
    "autohdr",
    "gamescope",
    "vulkan",
    "steamos",
    "bazzite"
  ]
}
